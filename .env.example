# DIGITAL SAATHI ENVIRONMENT VARIABLES CONFIGURATION

# Application Secret Key
SECRET_KEY=digital-saathi-academic-secret-key-2024-secure
JWT_EXPIRATION_HOURS=72
PORT=5000

# Database Configuration:
# By default, SQLite is used automatically with ZERO setup required (backend/digital_saathi.db).
# To connect to a MySQL server, uncomment and set the variables below:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/digital_saathi
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DB=digital_saathi

# Optional AI API Key (Gemini API for Digital Saathi AI Assistant):
# If left blank, the platform automatically uses the intelligent built-in multilingual knowledge base fallback!
GEMINI_API_KEY=
